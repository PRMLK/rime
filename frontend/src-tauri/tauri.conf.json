{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rime",
  "version": "0.1.5",
  "identifier": "com.prmlk.rime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/mobile.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rime",
        "url": "mobile.html",
        "width": 430,
        "height": 900,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Rime private music player",
    "longDescription": "Rime is a private music client for a self-hosted Rime server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.ios.plist"
    }
  }
}
